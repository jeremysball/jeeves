+++    let dir = std::env::temp_dir().join(format!("jeeves-hook-{}-{n}", std::process::id()));
+++    let _ = std::fs::remove_dir_all(&dir);
+++    std::fs::create_dir_all(&dir).unwrap();
+++    dir
