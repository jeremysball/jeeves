+
+    #[test]
+    fn worktree_list_parses_spaces_in_paths() {
+        let d = init_repo();
+        let wt = d.join("with space");
+        git(
+            &d,
+            &["worktree", "add", "-q", "-b", "wt1", &wt.to_string_lossy()],
+        );
+        let list = worktree_list(&d).unwrap();
+        assert_eq!(list.len(), 2);
